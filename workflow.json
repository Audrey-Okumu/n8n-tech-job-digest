    {
      "parameters": {
        "jsCode": "const jobs = $input.all().map(i => i.json);\nconst list = jobs.map((j, k) => (k + 1) + '. ' + j.title + ' at ' + j.company_name).join('\\n');\nconst prompt = 'You score job listings for a junior developer with these skills: Kotlin, Jetpack Compose, Android, Java, Python, Firebase, and a mobile development internship.\\n\\nScore each job below. Reply with exactly one line per job, in the same order, in this format: \"N. Score X/10: short reason\". No other text.\\n\\n' + list;\nreturn [{ json: { prompt, jobs: jobs.map(j => ({ title: j.title, company_name: j.company_name, url: j.url })) } }];"
      },
      "id": "7a1c2f10-3b4d-4e5f-8a9b-0c1d2e3f4a5b",
