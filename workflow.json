          "id": "eExIDRyWEaVVLzkh",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const jobs = $('Build Prompt').first().json.jobs;\nconst scoreLines = String($input.first().json.text || '').split('\\n').map(l => l.trim()).filter(Boolean);\nconst MIN_SCORE = 4;\n\nconst scored = jobs.map((j, k) => {\n  const found = scoreLines.find(l => l.startsWith((k + 1) + '.'));\n  const text = found ? found.replace(/^\\d+\\.\\s*/, '') : 'Score unavailable';\n  const m = text.match(/Score\\s*(\\d+)/i);\n  return { ...j, text, score: m ? parseInt(m[1], 10) : null };\n});\n\nconst kept = scored\n  .filter(j => j.score === null || j.score >= MIN_SCORE)\n  .sort((a, b) => (b.score ?? -1) - (a.score ?? -1));\n\nif (kept.length === 0) return [];\n\nconst lines = kept.map(j => '• ' + j.title + ' at ' + j.company_name + ' - ' + j.text + '\\n  ' + j.url);\nreturn [{ json: { digest: lines.join('\\n\\n'), count: kept.length } }];"
      },
